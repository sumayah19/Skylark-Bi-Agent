# --- Anthropic (required for the agent's reasoning) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- monday.com (required for live data; omit both to run in MOCK_MODE on sample data) ---
MONDAY_API_TOKEN=
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=

# --- Server ---
PORT=3000

# Set to "true" to force mock/sample data even if monday credentials are present
# (useful for demoing the agent without touching the real boards)
FORCE_MOCK_MODE=false
